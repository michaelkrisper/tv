# /etc/systemd/system/tv-api.service
[Unit]
Description=tv programme API (read-only, tv.krisperapps.de/api/)
# Caddy connects to the socket; systemd holds it, so requests wait during a
# restart instead of failing.
Requires=tv-api.socket
After=tv-api.socket

[Service]
# No account of its own: the service only reads world-readable files
# (its binary, the programme and the page).
DynamicUser=yes
# GOMEMLIMIT: collect garbage well below MemoryMax, also while a new file is loaded.
Environment=TV_DATA=/srv/apps/tv/tv.tsv TV_HTML=/srv/www/tv/index.html GOMEMLIMIT=128MiB
ExecStart=/srv/apps/tv/tv-api
Restart=on-failure
RestartSec=2
MemoryMax=256M

# Sandbox: read-only file system, no network at all: the only connection is
# the unix socket systemd passes in (Caddy is the only client).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
RemoveIPC=yes
UMask=0077
TasksMax=64
InaccessiblePaths=-/etc/caddy -/var/lib/caddy -/srv/build -/root

[Install]
WantedBy=multi-user.target
